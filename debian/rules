#!/usr/bin/make -f
%:
	dh $@ --buildsystem=cmake+ninja

override_dh_auto_configure:
	dh_auto_configure -- -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF

override_dh_auto_install:
	dh_auto_install
	mkdir -p debian/q-desktop-shell/etc/q-desktop
	echo "IDENTITY=DANTE" > debian/q-desktop-shell/etc/q-desktop/variant
